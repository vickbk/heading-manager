{
  "name": "react-heading-manager",
  "version": "0.1.0",
  "description": "Accessible automatic heading hierarchy and ARIA region landmark manager for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": {
        "import": "./dist/utils/index.d.mts",
        "require": "./dist/utils/index.d.cts"
      },
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.cjs"
    },
    "./testing": {
      "types": {
        "import": "./dist/testing/index.d.mts",
        "require": "./dist/testing/index.d.cts"
      },
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "heading level",
    "automatic",
    "header",
    "level",
    "title"
  ],
  "author": "Vick Bake",
  "license": "MIT",
  "sideEffects": false,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "tsdown": "^0.22.14",
    "typescript": "^6",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@playwright/test": "^1.30.0",
    "happy-dom": "^20.11.1",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  }
}
