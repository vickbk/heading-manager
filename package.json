{
  "name": "react-heading-manager",
  "version": "0.2.1-test",
  "description": "Accessible automatic heading hierarchy and ARIA region landmark manager for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "url": "https://github.com/vickbk/heading-manager"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "./utils": {
      "import": {
        "default": "./dist/utils/index.mjs",
        "types": "./dist/utils/index.d.mts"
      },
      "require": {
        "default": "./dist/utils/index.cjs",
        "types": "./dist/utils/index.d.cts"
      }
    },
    "./testing/playwright": {
      "import": {
        "default": "./dist/testing/playwright/index.mjs",
        "types": "./dist/testing/playwright/index.d.mts"
      },
      "require": {
        "default": "./dist/testing/playwright/index.cjs",
        "types": "./dist/testing/playwright/index.d.cts"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release-note": "tsx ./scripts/bin/extract-release-note.ts",
    "release-tag": "tsx ./scripts/bin/extract-version-tag.ts",
    "comment": "tsx ./scripts/bin/post-vitest-coverage.ts",
    "coverage-summary": "tsx ./scripts/bin/coverage-summary.ts"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "heading level",
    "react",
    "automatic",
    "header",
    "level",
    "title"
  ],
  "author": "Vick Bake",
  "license": "MIT",
  "sideEffects": false,
  "devEngines": {},
  "type": "module",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.30.0",
    "happy-dom": "^20.11.1",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  }
}
